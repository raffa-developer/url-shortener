# --- Node environment ---
NODE_ENV=development
PORT=3000

# Public base URL used to build the short links returned by the API.
# Prefixed with APP_ so it does not collide with the Vite/Vitest BASE_URL variable.
# e.g. http://localhost:3000 -> http://localhost:3000/aB72x
APP_BASE_URL=http://localhost:3000

# --- PostgreSQL ---
# Matches docker-compose.yml at the repo root. `?schema=public` is required by Prisma.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/url_shortener?schema=public

# --- Redis (redirect cache, from V4 onwards) ---
REDIS_URL=redis://localhost:6379
# Set to false to bypass the cache entirely (used by the redirect benchmark)
REDIRECT_CACHE_ENABLED=true
# Upper bound on how long a short code -> destination mapping is cached
REDIRECT_CACHE_TTL_SECONDS=3600
# Publish clicks to the Redis stream for the worker (false = record synchronously)
CLICK_EVENTS_ENABLED=true
# Redis stream used for click events (change to isolate environments)
CLICK_EVENT_STREAM_KEY=clicks:events

# Optional dev/demo country (ISO 3166-1 alpha-2) used ONLY when the client IP
# is private (e.g. localhost) and no CDN country header is present.
# Country resolution order: CDN header -> local GeoIP database -> this fallback.
# Leave empty in production.
GEOIP_FALLBACK_COUNTRY=

# --- Rate limiting (Redis-backed) ---
RATE_LIMIT_ENABLED=true
# Global limit per IP (or per API key when one is presented) per window
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60
# Stricter limit for register/login/refresh
AUTH_RATE_LIMIT_MAX=10
RATE_LIMIT_NAMESPACE=rl:
# Serve interactive API docs at /docs
API_DOCS_ENABLED=true

# Default length of generated short codes
SHORT_CODE_LENGTH=7

# Max attempts to resolve a random short-code collision before giving up
SHORT_CODE_MAX_ATTEMPTS=5

# --- Authentication ---
# Must be at least 32 characters. Generate one with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-secret-change-me-0123456789abcdef
# Access token lifetime in seconds (15 minutes)
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token lifetime in days
REFRESH_TOKEN_TTL_DAYS=30
