# Environment for the Docker Compose stack (docker compose reads this file).
# Copy to .env and fill in the values. .env is gitignored.

# Secret used to sign access tokens. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-secret-change-me-0123456789abcdef

# Public base URL of the API (used to build short links)
APP_BASE_URL=http://localhost:3000

# Public URL of the dashboard (used for links inside emails)
WEB_BASE_URL=http://localhost:8080

# --- Email (verification + password reset) ---
# Create an API key at https://resend.com/api-keys. Leave empty to log emails
# to the API container logs instead of sending them.
RESEND_API_KEY=
# While you have no verified domain, Resend only allows sending from
# onboarding@resend.dev and only to your own account address.
MAIL_FROM=Shortly <onboarding@resend.dev>

# Demo country shown for clicks from private IPs (e.g. browsing on localhost)
GEOIP_FALLBACK_COUNTRY=PT
